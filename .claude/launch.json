        "artisan",
        "serve",
        "--host=0.0.0.0",
        "--port=8000",
        "--no-reload"
      ],
      "port": 8000,
      "url": "http://gspos.192.168.100.25.nip.io:8000"
    },
    {
      "name": "laravel-8001",
